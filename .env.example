# ─── NexusOps Environment Configuration ─────────────────────────────────────

# Groq LLM API Key (required for IT incident AI agents)
# Get your key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# LLM Model (default: llama3-8b-8192, change to openai/gpt-oss-20b for higher quality)
DEFAULT_MODEL=llama3-8b-8192

# Python FastAPI backend URL (used by frontend)
VITE_API_URL=http://127.0.0.1:8000

# Node.js HCM backend URL (used by frontend)
VITE_HCM_URL=http://localhost:5000

# Node server port
PORT=5000

# Client origin for CORS (Node server)
CLIENT_ORIGIN=http://localhost:5173
